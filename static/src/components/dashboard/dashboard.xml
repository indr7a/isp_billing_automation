<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="isp_billing_automation.Dashboard">
        <div class="o_isp_dashboard container-fluid p-4 pb-5">
            <!-- Header Banner Dark Grey Charcoal Gradient -->
            <div class="card isp-header-banner shadow-sm mb-3 rounded-3 overflow-hidden">
                <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <h2 class="fw-bold mb-1 text-white">MikroTik Control Center</h2>
                        <p class="text-light opacity-75 mb-0 small">
                            Monitoring traffic real-time pelanggan aktif, peta topologi jaringan otomatis (MNDP), dan otomatisasi billing.
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <button t-on-click="() => this.loadDashboardData(false)" 
                                class="btn btn-outline-light text-white font-weight-bold shadow-sm d-flex align-items-center gap-2">
                            <i class="fa fa-refresh"></i> Refresh Data
                        </button>
                        <button t-on-click="onTriggerCron" 
                                t-att-disabled="state.cronRunning"
                                class="btn btn-success font-weight-bold shadow-sm d-flex align-items-center gap-2">
                            <i t-attf-class="fa #{state.cronRunning ? 'fa-spin fa-spinner' : 'fa-play'}"></i>
                            <span t-out="state.cronRunning ? 'Memproses Cron...' : 'Trigger Billing Cron (H-3 &amp; H+15)'"/>
                        </button>
                    </div>
                </div>
            </div>

            <!-- View Switcher Tabs (Dashboard vs Topology Map) -->
            <div class="d-flex gap-2 mb-4 border-bottom pb-2">
                <button t-on-click="() => this.setTab('dashboard')" 
                        t-attf-class="btn btn-sm #{state.activeTab == 'dashboard' ? 'btn-dark fw-bold' : 'btn-light border'} text-nowrap">
                    <i class="fa fa-tachometer me-1"></i> Dashboard Monitoring
                </button>
                <button t-on-click="() => this.setTab('topology')" 
                        t-attf-class="btn btn-sm #{state.activeTab == 'topology' ? 'btn-dark fw-bold' : 'btn-light border'} text-nowrap">
                    <i class="fa fa-sitemap me-1"></i> Visual Peta Topologi Jaringan (MNDP)
                </button>
            </div>

            <!-- Loading Spinner -->
            <div t-if="state.loading" class="text-center py-5">
                <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"></i>
                <p class="text-muted">Memuat data statistik &amp; topologi MikroTik...</p>
            </div>

            <!-- TAB 1: DASHBOARD MONITORING -->
            <div t-elif="state.activeTab == 'dashboard'" class="row g-4 pb-5">
                <!-- KPI Cards -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100 cursor-pointer" t-on-click="openSubscribers">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase font-weight-bold">Total Pelanggan</span>
                                <h3 class="fw-bold text-dark mb-0 mt-1" t-out="state.data.total_subscribers"/>
                                <span class="badge bg-success mt-2">
                                    <t t-out="state.data.active_subscribers"/> Aktif
                                </span>
                            </div>
                            <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-4">
                                <i class="fa fa-users"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100 cursor-pointer" t-on-click="openIsolatedSubscribers">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase font-weight-bold">Pelanggan Terisolir</span>
                                <h3 class="fw-bold text-warning mb-0 mt-1" t-out="state.data.isolated_subscribers"/>
                                <span class="text-muted small">Memerlukan pembayaran</span>
                            </div>
                            <div class="bg-warning-subtle text-warning p-3 rounded-circle fs-4">
                                <i class="fa fa-ban"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase font-weight-bold">Estimasi Revenue (MRR)</span>
                                <h4 class="fw-bold text-success mb-0 mt-1" t-out="formatIDR(state.data.mrr)"/>
                                <span class="text-muted small">Dari pelanggan aktif</span>
                            </div>
                            <div class="bg-success-subtle text-success p-3 rounded-circle fs-4">
                                <i class="fa fa-line-chart"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100 cursor-pointer" t-on-click="openUnpaidInvoices">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase font-weight-bold">Total Tunggakan (Unpaid)</span>
                                <h4 class="fw-bold text-danger mb-0 mt-1" t-out="formatIDR(state.data.total_unpaid_amount)"/>
                                <span class="text-muted small">
                                    <t t-out="state.data.unpaid_count"/> Invoice belum lunas
                                </span>
                            </div>
                            <div class="bg-danger-subtle text-danger p-3 rounded-circle fs-4">
                                <i class="fa fa-exclamation-triangle"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Interface Traffic Cards with Detailed History Chart Toggle -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa fa-line-chart text-info me-2"></i>Status Traffic &amp; Grafik Histori Interface MikroTik
                            </h6>
                            <span class="badge bg-success text-white font-monospace">Live (3s)</span>
                        </div>
                        <div class="card-body py-2">
                            <div t-if="!(state.data.traffic_interfaces &amp;&amp; state.data.traffic_interfaces.length)" class="text-muted small py-2">
                                Belum ada interface terdeteksi.
                            </div>
                            <div t-else="" class="row g-2">
                                <div t-foreach="state.data.traffic_interfaces" t-as="iface" t-key="iface.router_name + '_' + iface.name" class="col-12 col-sm-6 col-md-4 col-xl-3">
                                    <t t-set="ifaceKey" t-value="iface.router_name + '_' + iface.name"/>
                                    <t t-set="chartMeta" t-value="getChartMeta(ifaceKey)"/>
                                    <div class="p-2 border rounded bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="fw-bold small text-dark" t-out="iface.name"/>
                                            <div class="d-flex gap-1 align-items-center">
                                                <button t-on-click="() => this.toggleInterfaceChart(ifaceKey)" 
                                                        t-attf-class="btn btn-xs #{isChartEnabled(ifaceKey) ? 'btn-info text-white' : 'btn-outline-secondary'}"
                                                        style="padding: 1px 5px; font-size: 10px;"
                                                        title="Toggle Grafik Histori">
                                                    <i class="fa fa-line-chart"></i>
                                                </button>
                                                <span t-if="iface.running" class="badge bg-success" style="font-size: 10px;">UP</span>
                                                <span t-else="" class="badge bg-secondary" style="font-size: 10px;">DOWN</span>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 11px;">
                                            <span class="text-success font-monospace">
                                                <i class="fa fa-download me-1"></i><t t-out="formatSpeed(iface.rx_bps)"/>
                                            </span>
                                            <span class="text-primary font-monospace">
                                                <i class="fa fa-upload me-1"></i><t t-out="formatSpeed(iface.tx_bps)"/>
                                            </span>
                                        </div>
                                        <div class="text-end text-muted mt-1" style="font-size: 10px;">
                                            Total: <t t-out="formatBytes(iface.rx_bytes + iface.tx_bytes)"/>
                                        </div>

                                        <!-- Detailed Chart Panel (Y-axis Peak & 0bps, X-axis Time, Grid Lines) -->
                                        <div t-if="isChartEnabled(ifaceKey)" class="mt-2 pt-2 border-top bg-white p-2 rounded border">
                                            <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 9px;">
                                                <div>
                                                    <span class="text-success fw-bold me-2">━ RX</span>
                                                    <span class="text-primary fw-bold">┅ TX</span>
                                                </div>
                                                <div class="badge bg-light text-dark border font-monospace" style="font-size: 9px;">
                                                    Peak: <t t-out="chartMeta.peakFormatted"/>
                                                </div>
                                            </div>

                                            <div class="position-relative" style="height: 50px;">
                                                <svg width="100%" height="45" viewBox="0 0 220 45" style="background: #fafafa; border: 1px solid #e9ecef; border-radius: 4px;">
                                                    <line x1="0" y1="5" x2="220" y2="5" stroke="#dee2e6" stroke-dasharray="2,2"/>
                                                    <line x1="0" y1="22" x2="220" y2="22" stroke="#e9ecef" stroke-dasharray="2,2"/>
                                                    <line x1="0" y1="40" x2="220" y2="40" stroke="#ced4da" stroke-width="1"/>
                                                    
                                                    <line x1="55" y1="0" x2="55" y2="45" stroke="#f1f3f5" stroke-dasharray="2,2"/>
                                                    <line x1="110" y1="0" x2="110" y2="45" stroke="#f1f3f5" stroke-dasharray="2,2"/>
                                                    <line x1="165" y1="0" x2="165" y2="45" stroke="#f1f3f5" stroke-dasharray="2,2"/>

                                                    <polyline fill="none" stroke="#198754" stroke-width="2" t-att-points="chartMeta.rxPoints"/>
                                                    <polyline fill="none" stroke="#0d6efd" stroke-width="2" stroke-dasharray="3,3" t-att-points="chartMeta.txPoints"/>
                                                </svg>
                                            </div>

                                            <div class="d-flex justify-content-between text-muted font-monospace mt-1" style="font-size: 8px;">
                                                <span><i class="fa fa-clock-o me-1"></i><t t-out="chartMeta.startTime"/></span>
                                                <span>0 bps</span>
                                                <span><t t-out="chartMeta.endTime"/></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Active Subscriber Traffic Section -->
                <div class="col-12 col-lg-8">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="fa fa-tachometer text-primary me-2"></i>Traffic Pelanggan Aktif (Live Speed &amp; Total Volume)
                            </h5>
                            <span class="badge bg-primary text-white font-monospace">
                                <t t-out="(state.data.subscriber_traffics &amp;&amp; state.data.subscriber_traffics.length) || 0"/> Pelanggan Live
                            </span>
                        </div>
                        <div class="card-body">
                            <div t-if="!(state.data.subscriber_traffics &amp;&amp; state.data.subscriber_traffics.length)" class="text-center py-4 text-muted">
                                <i class="fa fa-users fa-2x mb-2 text-secondary"></i>
                                <p class="mb-0">Belum ada traffic pelanggan terpantau (Pastikan Simple Queue MikroTik telah dikonfigurasi/disinkronkan).</p>
                            </div>
                            <div t-else="" class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Pelanggan &amp; Queue</th>
                                            <th>IP Address</th>
                                            <th class="text-center">Status</th>
                                            <th class="text-end">Download (Rate / Total)</th>
                                            <th class="text-end">Upload (Rate / Total)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.data.subscriber_traffics" t-as="sub" t-key="sub.name + '_' + sub.queue_name">
                                            <td>
                                                <div class="fw-bold text-dark d-flex align-items-center gap-1">
                                                    <t t-out="sub.name"/>
                                                    <span t-if="!sub.is_registered" class="badge bg-light text-muted border font-monospace" style="font-size: 9px;" title="Belum terdaftar sebagai kontak di Odoo">Unregistered Queue</span>
                                                </div>
                                                <div class="text-muted font-monospace" style="font-size: 11px;">
                                                    <i class="fa fa-align-left me-1"></i><t t-out="sub.queue_name"/>
                                                </div>
                                            </td>
                                            <td class="font-monospace small text-muted">
                                                <t t-out="sub.ip_address || '-'"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-if="!sub.is_disabled" class="badge bg-success">
                                                    <i class="fa fa-check me-1"></i> Aktif
                                                </span>
                                                <span t-else="" class="badge bg-danger">
                                                    <i class="fa fa-ban me-1"></i> Isolir
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="fw-bold text-success">
                                                    <i class="fa fa-download me-1 opacity-50"></i>
                                                    <t t-out="formatSpeed(sub.rx_bps)"/>
                                                </div>
                                                <div class="text-muted font-monospace" style="font-size: 10px;">
                                                    Total: <t t-out="formatBytes(sub.rx_bytes)"/>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <div class="fw-bold text-primary">
                                                    <i class="fa fa-upload me-1 opacity-50"></i>
                                                    <t t-out="formatSpeed(sub.tx_bps)"/>
                                                </div>
                                                <div class="text-muted font-monospace" style="font-size: 10px;">
                                                    Total: <t t-out="formatBytes(sub.tx_bytes)"/>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Side Panel: Router Status & Recent Logs -->
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-3 mb-4 cursor-pointer" t-on-click="openRouters">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase font-weight-bold">Status Router MikroTik</span>
                                <h4 class="fw-bold mb-0 mt-1">
                                    <t t-out="state.data.connected_routers"/> / <t t-out="state.data.total_routers"/> Router Connected
                                </h4>
                            </div>
                            <div class="bg-info-subtle text-info p-3 rounded-circle fs-4">
                                <i class="fa fa-wifi"></i>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa fa-history text-secondary me-2"></i>Log Aktivitas Terbaru
                            </h6>
                            <button class="btn btn-sm btn-link p-0" t-on-click="openLogs">Lihat Semua</button>
                        </div>
                        <div class="card-body p-2">
                            <div t-if="!(state.data.recent_logs &amp;&amp; state.data.recent_logs.length)" class="text-muted text-center py-3 small">
                                Belum ada log aktivitas.
                            </div>
                            <div t-else="" class="list-group list-group-flush">
                                <div t-foreach="state.data.recent_logs" t-as="log" t-key="log.id" class="list-group-item px-2 py-2 border-0 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span t-attf-class="badge #{log.level == 'success' ? 'bg-success' : log.level == 'warning' ? 'bg-warning text-dark' : log.level == 'error' ? 'bg-danger' : 'bg-info'}">
                                            <t t-out="log.source"/>
                                        </span>
                                        <span class="text-muted text-nowrap" style="font-size: 10px;" t-out="log.timestamp"/>
                                    </div>
                                    <div class="small text-dark text-truncate" t-out="log.message"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: NETWORK TOPOLOGY MAP (MNDP / DISCOVERED NEIGHBORS) -->
            <div t-elif="state.activeTab == 'topology'" class="row g-4 pb-5">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="fa fa-sitemap text-primary me-2"></i>Visual Peta Topologi Jaringan (MNDP / LLDP / Discovered Neighbors)
                            </h5>
                            <span class="badge bg-dark text-white font-monospace">
                                <t t-out="(state.data.topology_nodes &amp;&amp; state.data.topology_nodes.length) || 0"/> Perangkat Terdeteksi
                            </span>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-4">
                                Topologi jaringan ini dibuat secara otomatis dari pengenalan protokol **MNDP / CDP / LLDP (`/ip/neighbor`)** dan Simple Queue pada Router MikroTik yang terhubung.
                            </p>

                            <div t-if="!(state.data.topology_nodes &amp;&amp; state.data.topology_nodes.length)" class="text-center py-5 text-muted">
                                <i class="fa fa-sitemap fa-3x mb-3 text-secondary"></i>
                                <p>Belum ada node topologi terdeteksi dari Router. Pastikan Router MikroTik terhubung dengan benar.</p>
                            </div>
                            
                            <div t-else="" class="p-3 bg-light rounded border">
                                <!-- Hierarchical Tree Visualizer -->
                                <div class="d-flex flex-column align-items-center gap-4">
                                    <!-- Level 1: Routers -->
                                    <div class="d-flex flex-wrap justify-content-center gap-3">
                                        <t t-foreach="state.data.topology_nodes" t-as="node" t-key="node.id">
                                            <div t-if="node.type == 'router'" class="p-3 bg-dark text-white rounded-3 shadow-sm text-center font-monospace" style="min-width: 180px;">
                                                <i class="fa fa-server fa-2x mb-2 text-info"></i>
                                                <div class="fw-bold" t-out="node.label"/>
                                                <div class="small opacity-75" t-out="node.ip"/>
                                                <span class="badge bg-success mt-2">Core Router</span>
                                            </div>
                                        </t>
                                    </div>

                                    <i class="fa fa-arrow-down text-secondary fs-4"></i>

                                    <!-- Level 2: Interfaces & Neighbors (Switches/AP) -->
                                    <div class="d-flex flex-wrap justify-content-center gap-3">
                                        <t t-foreach="state.data.topology_nodes" t-as="node" t-key="node.id">
                                            <div t-if="node.type == 'interface' or node.type == 'neighbor'" class="p-2 bg-white border rounded shadow-sm text-center" style="min-width: 150px;">
                                                <i t-attf-class="fa #{node.type == 'neighbor' ? 'fa-wifi text-primary' : 'fa-plug text-secondary'} fa-lg mb-1"></i>
                                                <div class="fw-bold small text-dark" t-out="node.label"/>
                                                <div class="text-muted font-monospace" style="font-size: 10px;" t-out="node.ip || 'Local Port'"/>
                                                <span t-if="node.status == 'up' or node.status == 'connected'" class="badge bg-success" style="font-size: 9px;">CONNECTED</span>
                                                <span t-else="" class="badge bg-secondary" style="font-size: 9px;">DOWN</span>
                                            </div>
                                        </t>
                                    </div>

                                    <i class="fa fa-arrow-down text-secondary fs-4"></i>

                                    <!-- Level 3: Subscribers -->
                                    <div class="w-100 p-3 bg-white rounded border">
                                        <h6 class="fw-bold text-dark mb-3"><i class="fa fa-users me-2 text-primary"></i>Pelanggan Terhubung (Subscribers)</h6>
                                        <div class="d-flex flex-wrap gap-2">
                                            <t t-foreach="state.data.topology_nodes" t-as="node" t-key="node.id">
                                                <div t-if="node.type == 'subscriber'" class="p-2 border rounded text-center bg-light" style="min-width: 140px;">
                                                    <i class="fa fa-user me-1" t-attf-class="#{node.status == 'active' ? 'text-success' : 'text-danger'}"></i>
                                                    <span class="fw-bold small text-dark" t-out="node.label"/>
                                                    <div class="text-muted font-monospace" style="font-size: 10px;" t-out="node.ip"/>
                                                    <span t-if="node.status == 'active'" class="badge bg-success" style="font-size: 8px;">AKTIF</span>
                                                    <span t-else="" class="badge bg-danger" style="font-size: 8px;">ISOLIR</span>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
