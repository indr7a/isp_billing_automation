<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="isp_billing_automation.Dashboard">
        <div class="o_isp_dashboard container-fluid p-4 pb-5">
            <!-- Header Banner -->
            <div class="card bg-dark text-white border-0 shadow-sm mb-4 rounded-3 overflow-hidden">
                <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="badge bg-info text-dark mb-2 font-monospace">
                            <i class="fa fa-circle text-success me-1"></i> Odoo 17 ISP Traffic &amp; Subscriber Monitor
                        </div>
                        <h2 class="fw-bold mb-1">ISP Billing &amp; MikroTik Control Center</h2>
                        <p class="text-white-50 mb-0 small">
                            Monitoring traffic real-time pelanggan aktif, otomatisasi pemblokiran tagihan, dan pengiriman notifikasi WhatsApp.
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <button t-on-click="() => this.loadDashboardData(false)" 
                                class="btn btn-outline-light font-weight-bold shadow-sm d-flex align-items-center gap-2">
                            <i class="fa fa-refresh"></i> Refresh Traffic
                        </button>
                        <button t-on-click="onTriggerCron" 
                                t-att-disabled="state.cronRunning"
                                class="btn btn-success font-weight-bold shadow-sm d-flex align-items-center gap-2">
                            <i t-attf-class="fa #{state.cronRunning ? 'fa-spin fa-spinner' : 'fa-play'}"></i>
                            <span t-out="state.cronRunning ? 'Memproses Cron...' : 'Trigger Billing Cron (H-3 &amp; H+15)'"/>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Loading Spinner -->
            <div t-if="state.loading" class="text-center py-5">
                <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"></i>
                <p class="text-muted">Memuat data statistik &amp; traffic pelanggan MikroTik...</p>
            </div>

            <!-- Dashboard Content -->
            <div t-else="" class="row g-4 pb-5">
                <!-- KPI Cards -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100 cursor-pointer" t-on-click="openSubscribers">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase font-weight-bold">Total Pelanggan</span>
                                <h3 class="fw-bold text-dark mb-0 mt-1" t-out="state.data.total_subscribers"/>
                                <span class="badge bg-success mt-2">
                                    <t t-out="state.data.active_subscribers"/> Aktif
                                </span>
                            </div>
                            <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-4">
                                <i class="fa fa-users"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100 cursor-pointer" t-on-click="openSubscribers">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase font-weight-bold">Pelanggan Terisolir</span>
                                <h3 class="fw-bold text-warning mb-0 mt-1" t-out="state.data.isolated_subscribers"/>
                                <span class="text-muted small">Memerlukan pembayaran</span>
                            </div>
                            <div class="bg-warning-subtle text-warning p-3 rounded-circle fs-4">
                                <i class="fa fa-ban"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase font-weight-bold">Estimasi Revenue (MRR)</span>
                                <h4 class="fw-bold text-success mb-0 mt-1" t-out="formatIDR(state.data.mrr)"/>
                                <span class="text-muted small">Dari pelanggan aktif</span>
                            </div>
                            <div class="bg-success-subtle text-success p-3 rounded-circle fs-4">
                                <i class="fa fa-line-chart"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase font-weight-bold">Total Tunggakan (Unpaid)</span>
                                <h4 class="fw-bold text-danger mb-0 mt-1" t-out="formatIDR(state.data.total_unpaid_amount)"/>
                                <span class="text-muted small">
                                    <t t-out="state.data.unpaid_count"/> Invoice belum lunas
                                </span>
                            </div>
                            <div class="bg-danger-subtle text-danger p-3 rounded-circle fs-4">
                                <i class="fa fa-exclamation-triangle"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Compact Interface Traffic Row -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa fa-server text-info me-2"></i>Status Traffic &amp; Bandwidth Interface MikroTik
                            </h6>
                            <span class="badge bg-success text-white font-monospace">Live (3s)</span>
                        </div>
                        <div class="card-body py-2">
                            <div t-if="!(state.data.traffic_interfaces &amp;&amp; state.data.traffic_interfaces.length)" class="text-muted small py-2">
                                Belum ada interface terdeteksi.
                            </div>
                            <div t-else="" class="row g-2">
                                <div t-foreach="state.data.traffic_interfaces" t-as="iface" t-key="iface.router_name + '_' + iface.name" class="col-12 col-sm-6 col-md-4 col-xl-3">
                                    <div class="p-2 border rounded bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="fw-bold small text-dark" t-out="iface.name"/>
                                            <span t-if="iface.running" class="badge bg-success" style="font-size: 10px;">UP</span>
                                            <span t-else="" class="badge bg-secondary" style="font-size: 10px;">DOWN</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center" style="font-size: 11px;">
                                            <span class="text-success font-monospace">
                                                <i class="fa fa-download me-1"></i><t t-out="formatSpeed(iface.rx_bps)"/>
                                            </span>
                                            <span class="text-primary font-monospace">
                                                <i class="fa fa-upload me-1"></i><t t-out="formatSpeed(iface.tx_bps)"/>
                                            </span>
                                        </div>
                                        <div class="text-end text-muted mt-1" style="font-size: 10px;">
                                            Total: <t t-out="formatBytes(iface.rx_bytes + iface.tx_bytes)"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Active Subscriber Traffic Section (With Live Rate & Total RX/TX Bytes) -->
                <div class="col-12 col-lg-8">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="fa fa-tachometer text-primary me-2"></i>Traffic Pelanggan Aktif (Live Speed &amp; Total Volume)
                            </h5>
                            <span class="badge bg-primary text-white font-monospace">
                                <t t-out="(state.data.subscriber_traffics &amp;&amp; state.data.subscriber_traffics.length) || 0"/> Pelanggan Live
                            </span>
                        </div>
                        <div class="card-body">
                            <div t-if="!(state.data.subscriber_traffics &amp;&amp; state.data.subscriber_traffics.length)" class="text-center py-4 text-muted">
                                <i class="fa fa-users fa-2x mb-2 text-secondary"></i>
                                <p class="mb-0">Belum ada traffic pelanggan terpantau (Pastikan Simple Queue MikroTik telah dikonfigurasi/disinkronkan).</p>
                            </div>
                            <div t-else="" class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Pelanggan &amp; Queue</th>
                                            <th>IP Address</th>
                                            <th class="text-center">Status</th>
                                            <th class="text-end">Download (Rate / Total)</th>
                                            <th class="text-end">Upload (Rate / Total)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.data.subscriber_traffics" t-as="sub" t-key="sub.name + '_' + sub.queue_name">
                                            <td>
                                                <div class="fw-bold text-dark" t-out="sub.name"/>
                                                <div class="text-muted font-monospace" style="font-size: 11px;">
                                                    <i class="fa fa-align-left me-1"></i><t t-out="sub.queue_name"/>
                                                </div>
                                            </td>
                                            <td class="font-monospace small text-muted">
                                                <t t-out="sub.ip_address || '-'"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-if="!sub.is_disabled" class="badge bg-success">
                                                    <i class="fa fa-check me-1"></i> Aktif
                                                </span>
                                                <span t-else="" class="badge bg-danger">
                                                    <i class="fa fa-ban me-1"></i> Isolir
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="fw-bold text-success">
                                                    <i class="fa fa-download me-1 opacity-50"></i>
                                                    <t t-out="formatSpeed(sub.rx_bps)"/>
                                                </div>
                                                <div class="text-muted font-monospace" style="font-size: 10px;">
                                                    Total: <t t-out="formatBytes(sub.rx_bytes)"/>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <div class="fw-bold text-primary">
                                                    <i class="fa fa-upload me-1 opacity-50"></i>
                                                    <t t-out="formatSpeed(sub.tx_bps)"/>
                                                </div>
                                                <div class="text-muted font-monospace" style="font-size: 10px;">
                                                    Total: <t t-out="formatBytes(sub.tx_bytes)"/>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Side Panel: Router Status & Recent Logs -->
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-3 mb-4 cursor-pointer" t-on-click="openRouters">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase font-weight-bold">Status Router MikroTik</span>
                                <h4 class="fw-bold mb-0 mt-1">
                                    <t t-out="state.data.connected_routers"/> / <t t-out="state.data.total_routers"/> Router Connected
                                </h4>
                            </div>
                            <div class="bg-info-subtle text-info p-3 rounded-circle fs-4">
                                <i class="fa fa-wifi"></i>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa fa-history text-secondary me-2"></i>Log Aktivitas Terbaru
                            </h6>
                            <button class="btn btn-sm btn-link p-0" t-on-click="openLogs">Lihat Semua</button>
                        </div>
                        <div class="card-body p-2">
                            <div t-if="!(state.data.recent_logs &amp;&amp; state.data.recent_logs.length)" class="text-muted text-center py-3 small">
                                Belum ada log aktivitas.
                            </div>
                            <div t-else="" class="list-group list-group-flush">
                                <div t-foreach="state.data.recent_logs" t-as="log" t-key="log.id" class="list-group-item px-2 py-2 border-0 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span t-attf-class="badge #{log.level == 'success' ? 'bg-success' : log.level == 'warning' ? 'bg-warning text-dark' : log.level == 'error' ? 'bg-danger' : 'bg-info'}">
                                            <t t-out="log.source"/>
                                        </span>
                                        <span class="text-muted text-nowrap" style="font-size: 10px;" t-out="log.timestamp"/>
                                    </div>
                                    <div class="small text-dark text-truncate" t-out="log.message"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
