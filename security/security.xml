<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_isp_billing" model="ir.module.category">
            <field name="name">ISP Billing &amp; Automation</field>
            <field name="description">Category for ISP Billing and MikroTik Management</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_isp_user" model="res.groups">
            <field name="name">User / Operator</field>
            <field name="category_id" ref="module_category_isp_billing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_isp_manager" model="res.groups">
            <field name="name">Administrator / Manager</field>
            <field name="category_id" ref="module_category_isp_billing"/>
            <field name="implied_ids" eval="[(4, ref('group_isp_user'))]"/>
        </record>
    </data>
</odoo>
