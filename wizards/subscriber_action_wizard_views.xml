<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_isp_subscriber_action_wizard_form" model="ir.ui.view">
        <field name="name">isp.subscriber.action.wizard.form</field>
        <field name="model">isp.subscriber.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Konfirmasi Aksi Status Layanan">
                <sheet>
                    <group>
                        <group string="Informasi Pelanggan &amp; Aksi">
                            <field name="partner_id"/>
                            <field name="action_type"/>
                        </group>
                        <group string="Pengaturan WhatsApp">
                            <field name="send_wa"/>
                            <field name="wa_phone" invisible="not send_wa"/>
                        </group>
                    </group>
                    <group string="Isi Pesan WhatsApp" invisible="not send_wa">
                        <field name="wa_message" placeholder="Tuliskan pesan WhatsApp yang akan dikirim..." nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Konfirmasi &amp; Eksekusi" type="object" class="btn-primary" icon="fa-check"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
