<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice Form View Extension -->
    <record id="view_move_form_isp_inherit" model="ir.ui.view">
        <field name="name">account.move.form.isp.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="is_isp_invoice"/>
                <field name="wa_reminder_sent" readonly="1" invisible="not is_isp_invoice"/>
                <field name="wa_isolir_sent" readonly="1" invisible="not is_isp_invoice"/>
            </xpath>
        </field>
    </record>

    <!-- ISP Invoices Action -->
    <record id="action_isp_invoices" model="ir.actions.act_window">
        <field name="name">ISP Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('is_isp_invoice', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_is_isp_invoice': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada Invoice ISP yang dibuat.
            </p>
        </field>
    </record>
</odoo>
