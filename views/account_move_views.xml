<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice Form View Extension -->
    <record id="view_move_form_isp_inherit" model="ir.ui.view">
        <field name="name">account.move.form.isp.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="is_isp_invoice"/>
                <field name="wa_reminder_sent" readonly="1" invisible="not is_isp_invoice"/>
                <field name="wa_isolir_sent" readonly="1" invisible="not is_isp_invoice"/>
            </xpath>
        </field>
    </record>

    <!-- Custom Tree View for ISP Unpaid Invoices -->
    <record id="view_isp_unpaid_invoice_tree" model="ir.ui.view">
        <field name="name">account.move.tree.isp.unpaid</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <tree string="Invoice Unpaid (Tunggakan ISP)" default_order="invoice_date_due asc, id desc">
                <field name="name" string="Nomor Invoice"/>
                <field name="partner_id" string="Nama Pelanggan"/>
                <field name="invoice_date" string="Tanggal Invoice"/>
                <field name="invoice_date_due" string="Jatuh Tempo" widget="remaining_days"/>
                <field name="amount_total" string="Total Tagihan" sum="Total"/>
                <field name="amount_residual" string="Nominal Belum Lunas" sum="Total Belum Lunas" class="fw-bold text-danger"/>
                <field name="payment_state" widget="badge" 
                       decoration-danger="payment_state == 'not_paid'" 
                       decoration-warning="payment_state == 'partial'"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </tree>
        </field>
    </record>

    <!-- ISP Invoices Action -->
    <record id="action_isp_invoices" model="ir.actions.act_window">
        <field name="name">ISP Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('is_isp_invoice', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_is_isp_invoice': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada Invoice ISP yang dibuat.
            </p>
        </field>
    </record>

    <!-- Action for ISP Unpaid Invoices (Grouped by Customer) -->
    <record id="action_isp_unpaid_invoices" model="ir.actions.act_window">
        <field name="name">Invoice Unpaid (Tunggakan ISP)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'not in', ['paid', 'in_payment', 'reversed']), '|', ('is_isp_invoice', '=', True), ('partner_id.is_isp_subscriber', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'group_by': 'partner_id'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_isp_unpaid_invoice_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tidak ada invoice tunggakan belum lunas. Semua pembayaran pelanggan aman!
            </p>
        </field>
    </record>
</odoo>
